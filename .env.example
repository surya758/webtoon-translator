# ---- pick ONE LLM backend (auto-detected from whichever credential is set) ----

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini          # any vision model; gpt-4.1-mini works too
# OPENAI_BASE_URL=                 # optional: OpenAI-compatible gateway

# Gemini Developer API (AI Studio key)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini on Vertex AI: drop service-account.json in the repo root, or:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_CLOUD_PROJECT=my-project  # with `gcloud auth application-default login`
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.5-flash-lite

# Force a backend / model instead of auto-detect (also: --provider / --model)
# LLM_PROVIDER=openai
# LLM_MODEL=

# ---- rendering / python ----
# FONT_PATH=/path/to/ComicFont.ttf           default: Comic Sans MS Bold (macOS) / DejaVu Sans Bold (Linux)
# FALLBACK_FONT_PATH=/path/to/Unicode.ttf    for symbols the comic font lacks (♡ ★)
# SCRUB_PYTHON=py/.venv/bin/python           interpreter with torch + onnxruntime + opencv
